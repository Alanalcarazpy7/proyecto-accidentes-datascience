# Paquetes de entrega: se generan localmente, no se versionan
dist/
build/
*.zip
*.rar
*.7z
*.tar
*.tar.gz



# NO ignorar: src/, notebooks/, requirements.txt, README.md, protocolos,
# manifiestos, dataset limpio Parquet, informes PDF, exportaciones HTML,
# tablas de resultados ni models/*.joblib (modelo exigido por la catedra).
